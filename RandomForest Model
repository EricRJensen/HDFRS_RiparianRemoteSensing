import pandas as pd

indicators_file = 'aim_rw_indicators.csv'
ndvi_file       = 'v1_s2_annual.csv'
characterization_file = 'aim_rw_F_PlotCharacterization.csv'
mvp_file        = 'rw_mvp_annual.csv'
rri_file        = 'rw_rri_annual_20250306.csv'
climate_file    = 'rw_climate.csv'
topo_file       = 'rw_topo.csv'

df1 = pd.read_csv(indicators_file)
df2 = pd.read_csv(ndvi_file)
df3 = pd.read_csv(characterization_file)
df4 = pd.read_csv(mvp_file)
df5 = pd.read_csv(rri_file)
df6 = pd.read_csv(climate_file)
df7 = pd.read_csv(topo_file)

dfs = [df1, df2, df3, df4, df5, df6, df7]

for i, df in enumerate(dfs):
    if 'EvaluationID' not in df.columns:
        if 'EvltnID' in df.columns:
            df = df.rename(columns={'EvltnID': 'EvaluationID'})
        elif 'ElvtnID' in df.columns:
            df = df.rename(columns={'ElvtnID': 'EvaluationID'})
    df['EvaluationID'] = df['EvaluationID'].astype(str)

    df = df[~df['EvaluationID'].str.startswith('AK')].copy()

    if 'Year' in df.columns and 'year' not in df.columns:
        df = df.rename(columns={'Year': 'year'})
    if 'Year_End' in df.columns and 'year' not in df.columns:
        df = df.rename(columns={'Year_End': 'year'})

    dfs[i] = df

df1, df2, df3, df4, df5, df6, df7 = dfs

merged_df = pd.merge(df1, df2, on=['EvaluationID', 'year'], how='inner')
merged_df = pd.merge(merged_df, df3, on='EvaluationID', how='inner')

if 'year' in df4.columns:
    merged_df = pd.merge(merged_df, df4, on=['EvaluationID', 'year'], how='inner')
else:
    merged_df = pd.merge(merged_df, df4, on='EvaluationID', how='inner')

if 'year' in df5.columns:
    merged_df = pd.merge(merged_df, df5, on=['EvaluationID', 'year'], how='inner')
else:
    merged_df = pd.merge(merged_df, df5, on='EvaluationID', how='inner')

if 'year' in df6.columns:
    merged_df = pd.merge(merged_df, df6, on=['EvaluationID', 'year'], how='inner')
else:
    merged_df = pd.merge(merged_df, df6, on='EvaluationID', how='inner')

if 'year' in df7.columns:
    merged_df = pd.merge(merged_df, df7, on=['EvaluationID', 'year'], how='inner')
else:
    merged_df = pd.merge(merged_df, df7, on='EvaluationID', how='inner')


merged_df.to_csv('merged_file.csv', index=False)
print("Files merged successfully and saved to 'merged_file.csv'")


import pandas as pd
from sklearn.ensemble import RandomForestRegressor
from sklearn.model_selection import train_test_split, cross_val_score, GridSearchCV
from sklearn.metrics import mean_squared_error, r2_score
from sklearn.preprocessing import StandardScaler

df = pd.read_csv("merged_file.csv", low_memory=False)
df = df[~df["EvaluationID"].str.startswith("AK")]

df["ndvi_diff"] = df["s2_amj_ndvi_median_mean"] - df["s2_jas_ndvi_median_mean"]
df["ndwi_diff"] = df["s2_amj_ndwi_median_mean"] - df["s2_jas_ndwi_median_mean"]

features = [
    "s2_amj_ndvi_median_mean","s2_jas_ndvi_median_mean","ndvi_diff",
    "s2_amj_ndwi_median_mean","s2_jas_ndwi_median_mean","ndwi_diff",
    "mvp_jas","mvp_mjjas","rri_10year","rri_5year",
    "pr_sum","tmmn_mean","elevation","mtpi","slope",
]
target = "TotalFoliarCover"

if "EvaluationID" not in df.columns:
    raise ValueError("Column 'EvaluationID' not found in the dataset.")

X = df[features]
y = df[target]

scaler = StandardScaler()
X_scaled = pd.DataFrame(
    scaler.fit_transform(X),
    index=X.index,      
    columns=features
)

X_train, X_test, y_train, y_test = train_test_split(
    X_scaled, y,
    test_size=0.20,
    random_state=42,
    shuffle=True
)

rf = RandomForestRegressor(
    n_estimators=300,
    max_depth=8,
    min_samples_split=20,
    min_samples_leaf=10,
    max_features=0.5,
    bootstrap=True,
    oob_score=True,
    max_samples=0.8,
    random_state=42,
    n_jobs=-1
)

cv_scores = cross_val_score(rf, X_train, y_train, cv=5, scoring='r2')
print(f"Cross-validation R^2 scores: {cv_scores}")
print(f"Mean CV R^2: {cv_scores.mean()}")

param_grid = {
    'n_estimators':      [100, 200, 300],
    'max_depth':         [5, 8, 10],
    'min_samples_split': [10, 20, 30],
    'min_samples_leaf':  [5, 10, 15],
    'max_features':      [0.3, 0.5, 'sqrt'],
    'max_samples':       [0.5, 0.8]
}

grid_search = GridSearchCV(
    estimator=rf,
    param_grid=param_grid,
    cv=5,
    scoring='r2',
    n_jobs=-1,
    verbose=1
)

grid_search.fit(X_train, y_train)
best_rf = grid_search.best_estimator_
print(f"\nBest parameters: {grid_search.best_params_}")

y_pred = best_rf.predict(X_test)

mse = mean_squared_error(y_test, y_pred)
r2 = r2_score(y_test, y_pred)
print("\nTest Set Performance:")
print("Mean Squared Error:", mse)
print("R^2 Score:", r2)

train_pred = best_rf.predict(X_train)
train_r2 = r2_score(y_train, train_pred)
print(f"\nTrain R^2: {train_r2} vs Test R^2: {r2}")

if abs(train_r2 - r2) > 0.1:
    print("Warning: Potential overfitting detected")

importances = pd.Series(best_rf.feature_importances_, index=features).sort_values(ascending=False)
print("\nFeature Importances:")
print(importances)

results = pd.DataFrame({
    "EvaluationID": df.loc[X_test.index, "EvaluationID"],
    "Actual_TotalFoliarCover": y_test,
    "Predicted_TotalFoliarCover": y_pred
}, index=X_test.index + 1)

print("\nSample predictions:")
print(results.head())

import pandas as pd
from sklearn.ensemble import RandomForestRegressor
from sklearn.model_selection import train_test_split, cross_val_score, GridSearchCV
from sklearn.metrics import mean_squared_error, r2_score
from sklearn.preprocessing import StandardScaler

df = pd.read_csv("merged_file.csv", low_memory=False)
df = df[~df["EvaluationID"].str.startswith("AK")]

df["ndvi_diff"] = df["s2_amj_ndvi_median_mean"] - df["s2_jas_ndvi_median_mean"]
df["ndwi_diff"] = df["s2_amj_ndwi_median_mean"] - df["s2_jas_ndwi_median_mean"]

features = [
    "s2_amj_ndvi_median_mean",
    "s2_jas_ndvi_median_mean",
    "ndvi_diff",
    "s2_amj_ndwi_median_mean",
    "s2_jas_ndwi_median_mean",
    "ndwi_diff",
    "mvp_jas",
    "mvp_mjjas",
    "rri_10year",
    "rri_5year",
    "pr_sum",
    "tmmn_mean",
    "elevation",
    "mtpi",
    "slope",
]
target = "AH_HydroFACCover"

if "EvaluationID" not in df.columns:
    raise ValueError("Column 'EvaluationID' not found in the dataset.")
if target not in df.columns:
    raise ValueError(f"Column '{target}' not found in the dataset.")

X = df[features]
y = df[target]

scaler = StandardScaler()
X_scaled = pd.DataFrame(
    scaler.fit_transform(X),
    index=X.index, 
    columns=features
)

X_train, X_test, y_train, y_test = train_test_split(
    X_scaled, y, test_size=0.3, random_state=42
)

rf = RandomForestRegressor(
    n_estimators=200,
    max_depth=12,
    min_samples_split=15,
    min_samples_leaf=6,
    max_features=0.5,
    bootstrap=True,
    max_samples=0.8,
    oob_score=True,
    random_state=42,
    n_jobs=-1
)

cv_scores = cross_val_score(rf, X_train, y_train, cv=5, scoring='r2')
print(f"Cross-validation R^2 scores: {cv_scores}")
print(f"Mean CV R^2: {cv_scores.mean()}")

param_grid = {
    'n_estimators':       [100, 200, 300],
    'max_depth':          [8, 12, 16],
    'min_samples_split':  [10, 15, 20],
    'min_samples_leaf':   [4, 6, 8],
    'max_features':       [0.4, 0.5, 'sqrt'],
    'max_samples':        [0.6, 0.8, 1.0]
}

grid_search = GridSearchCV(
    estimator=rf,
    param_grid=param_grid,
    cv=5,
    scoring='r2',
    n_jobs=-1,
    verbose=1
)

grid_search.fit(X_train, y_train)
best_rf = grid_search.best_estimator_
print(f"\nBest parameters: {grid_search.best_params_}")

y_pred = best_rf.predict(X_test)

mse = mean_squared_error(y_test, y_pred)
r2 = r2_score(y_test, y_pred)
print("\nTest Set Performance:")
print("Mean Squared Error:", mse)
print("R^2 Score:", r2)

train_pred = best_rf.predict(X_train)
train_r2 = r2_score(y_train, train_pred)
print(f"\nTrain R^2: {train_r2} vs Test R^2: {r2}")

if abs(train_r2 - r2) > 0.1:
    print("Warning: Potential overfitting detected (large gap between train and test R^2)")

importances = pd.Series(best_rf.feature_importances_, index=features).sort_values(ascending=False)
print("\nFeature Importances:")
print(importances)

results = pd.DataFrame({
    "EvaluationID": df.loc[X_test.index, "EvaluationID"],
    "Actual_AH_HydroFACCover": y_test,
    "Predicted_AH_HydroFACCover": y_pred
}, index=X_test.index + 1)
print("\nSample predictions:")
print(results.head())

print("OOB Score:", best_rf.oob_score_)
